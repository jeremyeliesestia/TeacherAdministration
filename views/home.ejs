        };
          }
          matieres[row.nom_matiere].vertFonce += Number(row.nb_vert_fonce);
          matieres[row.nom_matiere].vert += Number(row.nb_vert);
          matieres[row.nom_matiere].orange += Number(row.nb_orange);
          matieres[row.nom_matiere].rouge += Number(row.nb_rouge);
          matieres[row.nom_matiere].gris += Number(row.nb_gris);
          matieres[row.nom_matiere].count++;
        }
      });
      
      console.log(matieres);

    }









    function afficherRadarPour(nomEleve) {
      


    }







    // ajouter tous les noms des élèves dans la liste déroulante
    const select = document.getElementById('eleveSelect');
    eleves.forEach(eleve => {
      const option = document.createElement('option');
      option.value = eleve;
      option.textContent = eleve;
      select.appendChild(option);
    });

    // Premier élève par défaut
    if (eleves.length > 0) afficherRadarPour(eleves[0]);

    select.addEventListener('change', () => {
