  <!-- Contenu principal -->
  <div class="content" id="mainContent">

    <!-- Barre de profil -->
    <div class="header-bar">
      <div class="header-title">
        <span class="profile-text">Contrôle Continu - Tableau de bord</span>
      </div>

      <div class="profile">
        <span class="profile-text">Tiphaine Moureu</span>
        <a href="/"><img src="/profile/profilepicture.jpg" alt="Profile Picture"></a>
      </div>
    </div>

    <div class="page-container">
      <div class="chart-container">
        <h5>Nombre total de notes (toutes matières)</h5>
        <canvas id="pieGlobal"></canvas>
      </div>

      <div class="chart-container">
        <h5>Nombre total de notes par élèves</h5>
        <canvas id="barGroupedEleves"></canvas>
      </div>

      <div class="chart-container">
        <h5>Nombre total de notes par matieres</h5>
