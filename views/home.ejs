  <!-- JS sidebar -->
  <script>
    function toggleSidebar(forceState = null) {
      const sidebar = document.getElementById('sidebar');
      const content = document.getElementById('mainContent');

      if (forceState === "open") {
        sidebar.classList.remove('collapsed');
        content.classList.remove('collapsed');
      } else if (forceState === "close") {
        sidebar.classList.add('collapsed');
        content.classList.add('collapsed');
      } else {
        sidebar.classList.toggle('collapsed');
        content.classList.toggle('collapsed');
      }
    }

    function toggleMenu(id) {
      const sidebar = document.getElementById('sidebar');
      const menu = document.getElementById(id);
      const group = menu.closest('.menu-group');

      // Si la sidebar est fermée, on l'ouvre
      if (sidebar.classList.contains('collapsed')) {
        toggleSidebar("open");
      }

      // Gestion du menu cliqué
      group.classList.toggle('active');
    }

    // ✅ Fermer la sidebar en cliquant en dehors
    document.addEventListener('click', function (event) {
      const sidebar = document.getElementById('sidebar');
      const toggleBtn = sidebar.querySelector('.toggle-btn');

      // si la sidebar est ouverte
      if (!sidebar.classList.contains('collapsed')) {
        // clique en dehors de la sidebar et pas sur le bouton ☰
        if (!sidebar.contains(event.target) && event.target !== toggleBtn) {
          toggleSidebar("close");
        }
      }
    });
  </script>

  

  <script>
    // Récupérer les données passées par Node
    const rawData = <%- JSON.stringify(data) %>;
    const rawData2 = <%- JSON.stringify(dataEleves) %>; // Nouveau jeu de données

    // 1) Données globales agrégées
    const globalCounts = { vertFonce: 0, vert: 0, orange: 0, rouge: 0, gris: 0 };

    // 2) Données pour bar chart compétences (VERT-FONCE)
    const labelsCompetences = [];
    const vertFonceCompetences = [];

    // 3) Données pour line chart sur la 1ère matière
    const firstMatiere = rawData.length ? rawData[0].nom_matiere : null;
    const labelsMatiere = [];
    const vertFonceMatiere = [];
    const vertMatiere = [];
    const orangeMatiere = [];
    const rougeMatiere = [];
    const grisMatiere = [];

    // 5) Données pour histogramme par matière
    const matieresMap = {};
    rawData.forEach(row => {
      // Agrégation globale
      globalCounts.vertFonce += Number(row.nb_vert_fonce);
      globalCounts.vert += Number(row.nb_vert);
      globalCounts.orange += Number(row.nb_orange);
      globalCounts.rouge += Number(row.nb_rouge);
      globalCounts.gris += Number(row.nb_gris);

      // Pour bar chart compétences
      labelsCompetences.push(row.nom_competence);
      vertFonceCompetences.push(Number(row.nb_vert_fonce));

      // Pour line chart sur la 1ère matière
      if (row.nom_matiere === firstMatiere) {
        labelsMatiere.push(row.nom_competence);
        vertFonceMatiere.push(Number(row.nb_vert_fonce));
        vertMatiere.push(Number(row.nb_vert));
        orangeMatiere.push(Number(row.nb_orange));
        rougeMatiere.push(Number(row.nb_rouge));
        grisMatiere.push(Number(row.nb_gris));
      }

      // Pour histogramme par matière
      if (!matieresMap[row.nom_matiere]) {
        matieresMap[row.nom_matiere] = {
          vertFonce: 0,
          vert: 0,
          orange: 0,
          rouge: 0,
          gris: 0
        };
      }
      matieresMap[row.nom_matiere].vertFonce += Number(row.nb_vert_fonce);
      matieresMap[row.nom_matiere].vert += Number(row.nb_vert);
      matieresMap[row.nom_matiere].orange += Number(row.nb_orange);
      matieresMap[row.nom_matiere].rouge += Number(row.nb_rouge);
      matieresMap[row.nom_matiere].gris += Number(row.nb_gris);
    });

