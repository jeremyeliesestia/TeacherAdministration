    const dataMatiereVert = labelsMatieres.map(m => matieresMap[m].vert);
    const dataMatiereOrange = labelsMatieres.map(m => matieresMap[m].orange);
    const dataMatiereRouge = labelsMatieres.map(m => matieresMap[m].rouge);
