      </div>
      
    </div>

</div>

  <!-- JS Bootstrap -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- JS sidebar -->
  <script>
    function toggleSidebar(forceState = null) {
      const sidebar = document.getElementById('sidebar');
      const content = document.getElementById('mainContent');

      if (forceState === "open") {
        sidebar.classList.remove('collapsed');
        content.classList.remove('collapsed');
      } else if (forceState === "close") {
        sidebar.classList.add('collapsed');
        content.classList.add('collapsed');
      } else {
        sidebar.classList.toggle('collapsed');
        content.classList.toggle('collapsed');
      }
    }

    function toggleMenu(id) {
      const sidebar = document.getElementById('sidebar');
      const menu = document.getElementById(id);
      const group = menu.closest('.menu-group');

      // Si la sidebar est fermée, on l'ouvre
      if (sidebar.classList.contains('collapsed')) {
        toggleSidebar("open");
      }

      // Gestion du menu cliqué
      group.classList.toggle('active');
    }

    // ✅ Fermer la sidebar en cliquant en dehors
    document.addEventListener('click', function (event) {
      const sidebar = document.getElementById('sidebar');
      const toggleBtn = sidebar.querySelector('.toggle-btn');

      // si la sidebar est ouverte
      if (!sidebar.classList.contains('collapsed')) {
        // clique en dehors de la sidebar et pas sur le bouton ☰
        if (!sidebar.contains(event.target) && event.target !== toggleBtn) {
          toggleSidebar("close");
        }
      }
    });
  </script>

  <script>
    // Récupérer les données passées par Node
    const rawData = <%- JSON.stringify(data) %>;
    const rawData2 = <%- JSON.stringify(dataEleves) %>; 

    // 1) Données globales agrégées
    const globalCounts = { vertFonce: 0, vert: 0, orange: 0, rouge: 0, gris: 0 };

    // 2) Données pour bar chart compétences (VERT-FONCE)
    const labelsCompetences = [];
    const vertFonceCompetences = [];

    // 3) Données pour line chart sur la 1ère matière
    const firstMatiere = rawData.length ? rawData[0].nom_matiere : null;
    const labelsMatiere = [];
    const vertFonceMatiere = [];
    const vertMatiere = [];
    const orangeMatiere = [];
    const rougeMatiere = [];
    const grisMatiere = [];

    // 5) Données pour histogramme par matière
    const matieresMap = {};
    rawData.forEach(row => {
      // Agrégation globale
      globalCounts.vertFonce += Number(row.nb_vert_fonce);
      globalCounts.vert += Number(row.nb_vert);
      globalCounts.orange += Number(row.nb_orange);
      globalCounts.rouge += Number(row.nb_rouge);
      globalCounts.gris += Number(row.nb_gris);

      // Pour bar chart compétences
      labelsCompetences.push(row.nom_competence);
      vertFonceCompetences.push(Number(row.nb_vert_fonce));

      // Pour line chart sur la 1ère matière
      if (row.nom_matiere === firstMatiere) {
        labelsMatiere.push(row.nom_competence);
        vertFonceMatiere.push(Number(row.nb_vert_fonce));
        vertMatiere.push(Number(row.nb_vert));
        orangeMatiere.push(Number(row.nb_orange));
        rougeMatiere.push(Number(row.nb_rouge));
        grisMatiere.push(Number(row.nb_gris));
      }

      // Pour histogramme par matière
      if (!matieresMap[row.nom_matiere]) {
        matieresMap[row.nom_matiere] = {
          vertFonce: 0,
          vert: 0,
          orange: 0,
          rouge: 0,
          gris: 0
        };
      }
      matieresMap[row.nom_matiere].vertFonce += Number(row.nb_vert_fonce);
      matieresMap[row.nom_matiere].vert += Number(row.nb_vert);
      matieresMap[row.nom_matiere].orange += Number(row.nb_orange);
      matieresMap[row.nom_matiere].rouge += Number(row.nb_rouge);
      matieresMap[row.nom_matiere].gris += Number(row.nb_gris);
    });

    // 4) Données par élève pour histogramme groupé (rawData2)
    const labelsEleves = [];
    const labelsElevesFull = [];
    const dataEleveVertFonce = [];
    const dataEleveVert = [];
    const dataEleveOrange = [];
    const dataEleveRouge = [];
    const dataEleveGris = [];

    rawData2.forEach(row => {
      labelsEleves.push(row.name); // ou row.nom si aliasé ainsi
      labelsElevesFull.push(row.fullname);
      dataEleveVertFonce.push(Number(row.nb_vert_fonce));
      dataEleveVert.push(Number(row.nb_vert));
      dataEleveOrange.push(Number(row.nb_orange));
      dataEleveRouge.push(Number(row.nb_rouge));
      dataEleveGris.push(Number(row.nb_gris));
    });
    console.log("Données par élève:", rawData2);
    const eleves = rawData2.map(row => `${row.fullname} ${row.name}`);

    // 5) Préparation des données pour histogramme par matière
    const labelsMatieres = Object.keys(matieresMap);
    const dataMatiereVertFonce = labelsMatieres.map(m => matieresMap[m].vertFonce);
    const dataMatiereVert = labelsMatieres.map(m => matieresMap[m].vert);
    const dataMatiereOrange = labelsMatieres.map(m => matieresMap[m].orange);
    const dataMatiereRouge = labelsMatieres.map(m => matieresMap[m].rouge);
    const dataMatiereGris = labelsMatieres.map(m => matieresMap[m].gris);

    // 1) Pie chart global
    new Chart(document.getElementById('pieGlobal').getContext('2d'), {
      type: 'doughnut',
      data: {
      labels: ['', '', '', '', ''],
      datasets: [{
        label: 'Répartition globale',
        data: [
        globalCounts.vertFonce,
        globalCounts.vert,
        globalCounts.orange,
        globalCounts.rouge,
        globalCounts.gris
        ],
        backgroundColor: ['#60872D', '#CAFF76', '#FFBA6B', '#FF8C8C', '#DADADA'],
        borderWidth: 0 // Remove white contouring
      }]
      },
      options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
        labels: { color: '#fff' }
        }
      }
      }
    });

    // 2) Histogramme groupé
    new Chart(document.getElementById('barGroupedEleves').getContext('2d'), {
      type: 'bar',
      data: {
      labels: labelsEleves,
      datasets: [
        { label: '', data: dataEleveVertFonce, backgroundColor: '#60872D' },
        { label: '', data: dataEleveVert, backgroundColor: '#CAFF76' },
        { label: '', data: dataEleveOrange, backgroundColor: '#FFBA6B' },
        { label: '', data: dataEleveRouge, backgroundColor: '#FF8C8C' },
        { label: '', data: dataEleveGris, backgroundColor: '#DADADA' }
      ]
      },
      options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { 
        position: 'top',
        labels: { color: '#fff' }
        }
      },
      scales: {
        x: {
        stacked: false,
        title: { display: true, text: 'Élèves', color: '#fff' },
        ticks: { maxRotation: 90, minRotation: 45, color: '#fff' }
        },
        y: {
        beginAtZero: true,
        title: { display: true, text: 'Nombre de compétences', color: '#fff' },
        ticks: { color: '#fff' }
        }
      }
      }
    });

    // 3) Histogramme groupé par matière (horizontal)
    if (document.getElementById('barGroupedMatieres')) {
      new Chart(document.getElementById('barGroupedMatieres').getContext('2d'), {
      type: 'bar',
      data: {
        labels: labelsMatieres,
        datasets: [
        { label: '', data: dataMatiereVertFonce, backgroundColor: '#60872D', barThickness: 15 },
        { label: '', data: dataMatiereVert, backgroundColor: '#CAFF76', barThickness: 15 },
        { label: '', data: dataMatiereOrange, backgroundColor: '#FFBA6B', barThickness: 15 },
        { label: '', data: dataMatiereRouge, backgroundColor: '#FF8C8C', barThickness: 15 },
        { label: '', data: dataMatiereGris, backgroundColor: '#DADADA', barThickness: 15 }
        ]
      },
      options: {
        indexAxis: 'y', // Make the bar chart horizontal
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: {
          position: 'top',
          labels: { color: '#fff' }
        }
        },
        scales: {
        x: {
          beginAtZero: true,
          title: { display: true, text: 'Nombre', color: '#fff' },
          ticks: { color: '#fff' }
        },
        y: {
          stacked: false,
          title: { display: true, text: 'Matières', color: '#fff' },
          ticks: { color: '#fff' }
        }
        }
      }
      });
    }
  
    // 4) Radar chart par élève
    
    // ajouter tous les noms des élèves dans la liste déroulante
    const select = document.getElementById('eleveSelect');
    eleves.forEach(eleve => {
      const option = document.createElement('option');
      option.value = eleve;
      option.textContent = eleve;
      select.appendChild(option);
    });
    const selectedEleveFirst = select.value;
    getSQLTableByEleve(selectedEleveFirst);
    afficherRadarPour(selectedEleveFirst);

    select.addEventListener('change', () => {
      const selectedEleve = select.value;
      getSQLTableByEleve(selectedEleve);
      afficherRadarPour(selectedEleve);
    });

    async function getSQLTableByEleve(studentSelected) {
    try {
      const response = await fetch(`/api/notes/${encodeURIComponent(studentSelected)}`);
      if (!response.ok) throw new Error("Erreur serveur: " + response.status);
      
      const data = await response.json();
      console.log("Données reçues:", data);
      return data;
    } catch (error) {
      console.error("Erreur lors de la récupération:", error);
    }
  }

    async function afficherRadarPour(studentSelected) {
      console.log("Afficher radar pour:", studentSelected);

      // 1 Récupérer les données SQL pour l'élève
      const data = await getSQLTableByEleve(studentSelected);
      console.log("Structure d'une ligne:", data[0]); // Voir les vrais noms de champs
      if (!data || data.length === 0) {
        console.warn("Aucune donnée trouvée pour l'élève", studentSelected);
        return;
      }

      // 2️ Table de conversion couleur → score
      const scoreMap = {
        "VERT-FONCE": 100,
        "VERT": 75,
        "ORANGE": 50,
        "ROUGE": 25,
        "GRIS": 0
      };

      // 3️ Calcul des moyennes par matière
      const scoresParMatiere = {};
      data.forEach(row => {
        const matiere = row.matiere;
        const score = scoreMap[row.note] ?? 0;

        if (!scoresParMatiere[matiere]) {
          scoresParMatiere[matiere] = { total: 0, count: 0 };
        }
        scoresParMatiere[matiere].total += score;
        scoresParMatiere[matiere].count += 1;
      });

      const labels = [];
      const moyennes = [];
      for (const matiere in scoresParMatiere) {
        labels.push(matiere);
        const { total, count } = scoresParMatiere[matiere];
        moyennes.push(total / count);
      }

      // 4️ Supprimer l'ancien radar chart s'il existe
      if (window.radarChartInstance) {
        window.radarChartInstance.destroy();
      }

      // 5️ Créer le radar chart
      const ctx = document.getElementById("radarChart").getContext("2d");
      window.radarChartInstance = new Chart(ctx, {
        type: "radar",
        data: {
          labels: labels,
          datasets: [{
            label: `Scores moyens - ${studentSelected}`,
            data: moyennes,
            backgroundColor: "rgba(202, 255, 118, 0.15)",
            borderColor: "#CAFF76",
            borderWidth: 2,
            pointBackgroundColor: "#CAFF76",
            pointBorderColor: "#60872D",
            pointBorderWidth: 2,
            pointRadius: 5,
            pointHoverRadius: 7,
            pointHoverBackgroundColor: "#fff",
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            r: {
              beginAtZero: true,
              max: 100,
              ticks: {
                stepSize: 25,
                color: "rgba(255,255,255,0.5)",
                backdropColor: "transparent",
                font: { size: 10 }
              },
              grid: {
                color: "rgba(255, 255, 255, 0.1)",
                circular: true           // ← grille circulaire au lieu de polygonale
              },
              angleLines: {
                color: "rgba(255, 255, 255, 0.15)",
                lineWidth: 1
              },
              pointLabels: {
                color: "#fff",
                font: { size: 13, weight: "bold" },
                padding: 10
              }
            }
          },
          plugins: {
            legend: {
              display: false            // ← on supprime la légende, le select suffit
            },
            tooltip: {
              backgroundColor: "rgba(0,0,0,0.7)",
              titleColor: "#CAFF76",
              bodyColor: "#fff",
              borderColor: "#CAFF76",
              borderWidth: 1,
              callbacks: {
                label: (ctx) => ` ${ctx.raw} / 100`
              }
            }
          }
        }
      });
    }



  </script>


</body>
